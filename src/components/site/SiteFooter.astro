---
// Shared marketing-site footer. Used by any Tailwind-based page (index.astro,
// python.astro, ...) — import ../../styles/site-tailwind.css on the page
// before using this component.
---

<footer class="relative z-10 mt-12 border-t border-border px-8 py-8">
	<div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-8 sm:flex-row">
		<div class="flex max-w-[56ch] flex-col items-start gap-2.5">
			<span class="font-mono text-base font-medium text-accent">act()</span>
			<p class="text-[0.85rem] leading-relaxed text-muted-foreground">
				Hardened tools for AI agents — one signed, sandboxed component runs over MCP, CLI, HTTP, or right in the
				browser.
			</p>
			<span class="font-mono text-[0.8rem] text-fainter-foreground">© 2026 actcore</span>
		</div>
		<div class="flex flex-wrap gap-6 font-body text-[0.85rem] text-muted-foreground">
			<a href="/docs/" class="transition-colors hover:text-foreground">Docs</a>
			<a href="/blog/" class="transition-colors hover:text-foreground">Blog</a>
			<a href="https://github.com/actcore" target="_blank" rel="noopener" class="transition-colors hover:text-foreground"
				>GitHub</a
			>
			<a href="https://playground.actcore.dev" target="_blank" rel="noopener" class="transition-colors hover:text-foreground"
				>Playground</a
			>
			<a
				href="https://github.com/actcore/act-spec/discussions"
				target="_blank"
				rel="noopener"
				class="transition-colors hover:text-foreground">Discussions</a
			>
		</div>
	</div>
</footer>
