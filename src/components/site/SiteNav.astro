---
// Shared marketing-site nav. Used by any Tailwind-based page (index.astro,
// python.astro, ...) — import ../../styles/site-tailwind.css on the page
// before using this component.
---

<nav class="sticky top-0 z-[100] border-b border-border bg-background/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-4 sm:px-8">
		<a href="/" class="inline-flex items-center gap-2.5">
			<span class="font-mono text-xl font-medium text-accent">act()</span>
		</a>
		<div class="flex items-center gap-7">
			<div class="hidden gap-8 font-body text-sm text-muted-foreground sm:flex">
				<a href="/python" class="inline-flex items-center gap-1.5 text-foreground transition-colors hover:text-accent">
					<span class="inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
					Try in browser
				</a>
				<a href="/docs/" class="transition-colors hover:text-foreground">Docs</a>
				<a href="https://actpkg.dev" target="_blank" rel="noopener" class="transition-colors hover:text-foreground"
					>Components</a
				>
				<a href="/blog/" class="transition-colors hover:text-foreground">Blog</a>
				<a href="https://github.com/actcore" target="_blank" rel="noopener" class="transition-colors hover:text-foreground"
					>GitHub</a
				>
			</div>
			<a
				href="https://github.com/actcore/act-cli"
				target="_blank"
				rel="noopener"
				class="inline-flex items-center gap-2 rounded-lg border border-border-medium px-3.5 py-1.5 text-sm text-foreground transition-colors hover:border-accent-600 hover:text-accent"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-accent"
					><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01z" /></svg
				>
				Star
			</a>
		</div>
	</div>
</nav>
